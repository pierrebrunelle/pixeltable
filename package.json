{
  "name": "@pixeltable/sdk",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Typed client for Pixeltable HTTP services",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "ROADMAP.md",
    "CODEBASE_GUIDE.md"
  ],
  "bin": {
    "pxt-generate-ts": "./bin/generate.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "npm run build && npm run typecheck && node --test --test-timeout=10000 tests/*.test.mjs",
    "generate": "node bin/generate.mjs",
    "prepack": "npm run build",
    "test:integration": "npm run build && node tests/integration.mjs",
    "format": "prettier --write src bin tests/*.mjs tests/types.ts examples *.json *.md",
    "format:check": "prettier --check src bin tests/*.mjs tests/types.ts examples *.json *.md"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  },
  "license": "Apache-2.0"
}
