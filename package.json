{
  "name": "@pixeltable/sdk",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Typed client for Pixeltable HTTP services",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "ROADMAP.md",
    "CODEBASE_GUIDE.md"
  ],
  "bin": {
    "pxt-generate-ts": "./bin/generate.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "npm run build && npm run typecheck && node --test --test-timeout=10000 tests/*.test.mjs",
    "generate": "node bin/generate.mjs",
    "prepack": "npm run build",
    "test:integration": "npm run build && node tests/integration.mjs",
    "format": "prettier --write src bin tests/*.mjs tests/types.ts examples *.json *.md",
    "format:check": "prettier --check src bin tests/*.mjs tests/types.ts examples *.json *.md"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.103.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  }
}
